# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
COMPANY_NAME=AstreaBlue Enterprise ITSM

# Use MAIN_HUB only for the authoritative central support deployment.
INSTANCE_ID=LOCAL
DEPLOYMENT_PROFILE=STANDARD

# Local PostgreSQL. Use DATABASE_URL instead of these fields in hosted environments.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_asset_management
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=

# Authentication and endpoint security. Replace every placeholder locally.
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPERADMIN_NAME=Super Administrator
MONITORING_AGENT_TOKEN=replace-with-a-random-agent-token
SCREENSHOT_ENCRYPTION_KEY=

# Email (optional in local development)
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AstreaBlue ITSM
SMTP_FROM_EMAIL=
EMAIL_BRAND_NAME=AstreaBlue ITSM

# Cloudflare R2 private storage (optional)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI assistant (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Endpoint monitoring policy defaults (optional)
MONITORING_ONLINE_THRESHOLD_SECONDS=180
MONITORING_IDLE_ALERT_SECONDS=3600
MONITORING_PROHIBITED_APPS=
MONITORING_PROHIBITED_DOMAINS=
DLP_HIGH_RISK_EXTENSIONS=
DLP_SENSITIVE_FILENAME_KEYWORDS=
DLP_LARGE_TRANSFER_MB=100
